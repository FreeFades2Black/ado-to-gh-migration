# ==============================================================================
# Azure DevOps to GitHub Migration Configuration
# ==============================================================================

# Azure DevOps Configuration
ADO_ORG="your-ado-organization"
ADO_PROJECT="your-ado-project"
ADO_PAT="your-ado-personal-access-token"

# GitHub Enterprise Configuration
GH_ORG="your-target-github-org"
GH_PAT="your-github-personal-access-token"

# Migration Options
MIGRATION_MODE="live"       # "live" or "mock"
LOG_DIR="./logs"
STATE_FILE="./config/migration-state.json"
MAX_RETRIES=3
WAIT_FOR_COMPLETION="true"
